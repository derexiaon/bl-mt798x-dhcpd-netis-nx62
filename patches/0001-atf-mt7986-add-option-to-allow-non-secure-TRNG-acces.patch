--- a/atf-20260123/plat/mediatek/mt7986/drivers/devapc/devapc.c
+++ b/atf-20260123/plat/mediatek/mt7986/drivers/devapc/devapc.c
@@ -9,6 +9,16 @@
 
 #include <devapc.h>
 
+/*
+ * TRNG is secure-only by default (random numbers are provided through the
