From 0cd62da54dafd8d0d825e5c8f294cfd6b8b2cb6b Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 4 Oct 2026 20:23:18 +0000
Subject: [PATCH] atf: mt7986: add option to allow non-secure TRNG access

ATF 2025/2026 restricts TRNG_APB_S to secure world and serves random
numbers through the MTK_SIP_TRNG_GET_RND SMC. MediaTek SDK kernel 5.4
(stock firmware) reads the TRNG registers directly and gets hwrng errors.

Add _MT7986_TRNG_NS_ACCESS (default n) to keep domain 0 unprotected, so
both direct access and the SMC interface work.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AYm4drLdo4LK2sWwMMdxGB
---
 atf-20250711/plat/mediatek/mt7986/Config.in   | 18 +++++++++++++
 .../plat/mediatek/mt7986/bl31/bl31.mk         |  4 +++
 .../mediatek/mt7986/drivers/devapc/devapc.c   | 12 ++++++++-
 atf-20250711/plat/mediatek/mt7986/platform.mk |  3 ++-
 .../plat/mediatek/apsoc_common/Config.in      |  1 +
 atf-20260123/plat/mediatek/mt7986/Config.in   | 26 +++++++++++++++++++
 .../plat/mediatek/mt7986/bl31/bl31.mk         |  4 +++
 .../mediatek/mt7986/drivers/devapc/devapc.c   | 12 ++++++++-
 atf-20260123/plat/mediatek/mt7986/platform.mk |  3 ++-
 9 files changed, 79 insertions(+), 4 deletions(-)
 create mode 100644 atf-20260123/plat/mediatek/mt7986/Config.in

diff --git a/atf-20250711/plat/mediatek/mt7986/Config.in b/atf-20250711/plat/mediatek/mt7986/Config.in
index 4138e882..7846dd58 100644
--- a/atf-20250711/plat/mediatek/mt7986/Config.in
+++ b/atf-20250711/plat/mediatek/mt7986/Config.in
@@ -70,4 +70,22 @@ config MT7986_TRNG_VERSION
 	default 1 if MT7986_TRNG_V1
 	default 2 if MT7986_TRNG_V2
 
+config _MT7986_TRNG_NS_ACCESS
+	bool "Allow non-secure world to access TRNG registers directly"
+	default n
+	help
+	  By default BL31 restricts the TRNG to secure world only and exposes
+	  random numbers through the MTK_SIP_TRNG_GET_RND SMC call.
+	  Vendor firmwares based on the MediaTek SDK kernel 5.4 read the TRNG
+	  registers directly and fail (hwrng errors) with this restriction.
+	  Say Y here to keep both the SMC interface and direct register access
+	  working, e.g. for boards which must boot both stock and OpenWrt
+	  firmware.
+
+# Makefile option
+config MT7986_TRNG_NS_ACCESS
+	int
+	default 1
+	depends on _MT7986_TRNG_NS_ACCESS
+
 endif # _PLAT_MT7986
diff --git a/atf-20250711/plat/mediatek/mt7986/bl31/bl31.mk b/atf-20250711/plat/mediatek/mt7986/bl31/bl31.mk
index 2fa6e75f..f73cf352 100644
--- a/atf-20250711/plat/mediatek/mt7986/bl31/bl31.mk
+++ b/atf-20250711/plat/mediatek/mt7986/bl31/bl31.mk
@@ -55,5 +55,9 @@ ifeq ($(ENABLE_BL31_RUNTIME_LOG), 1)
 BL31_CPPFLAGS		+=	-DENABLE_BL31_RUNTIME_LOG
 endif
 
+ifeq ($(MT7986_TRNG_NS_ACCESS), 1)
+BL31_CPPFLAGS		+=	-DMT7986_TRNG_NS_ACCESS
+endif
+
 MTK_SIP_KERNEL_BOOT_ENABLE := 1
 $(eval $(call add_define,MTK_SIP_KERNEL_BOOT_ENABLE))
diff --git a/atf-20250711/plat/mediatek/mt7986/drivers/devapc/devapc.c b/atf-20250711/plat/mediatek/mt7986/drivers/devapc/devapc.c
index 03e941df..192fb779 100644
--- a/atf-20250711/plat/mediatek/mt7986/drivers/devapc/devapc.c
+++ b/atf-20250711/plat/mediatek/mt7986/drivers/devapc/devapc.c
@@ -9,6 +9,16 @@
 
 #include <devapc.h>
 
+/*
+ * TRNG is secure-only by default (random numbers are provided through the
+ * MTK_SIP_TRNG_GET_RND SMC). Legacy vendor kernels access it directly.
+ */
+#ifdef MT7986_TRNG_NS_ACCESS
+#define TRNG_APB_S_DOMAIN0_PERM		NO_PROTECTION
+#else
+#define TRNG_APB_S_DOMAIN0_PERM		SEC_RW_ONLY
+#endif
+
 /* Infra_ao */
 static const struct APC_INFRA_PERI_DOM_16 INFRA_AO_SYS0_Devices[] = {
 
@@ -440,7 +450,7 @@ DAPC_INFRA_AO_SYS0_ATTR("INFRACFG_PDN_AUTO_APB_S",
 			FORBIDDEN,     FORBIDDEN,     FORBIDDEN,     FORBIDDEN,
 			FORBIDDEN,     FORBIDDEN,     FORBIDDEN,     FORBIDDEN),
 DAPC_INFRA_AO_SYS0_ATTR("TRNG_APB_S",
-			SEC_RW_ONLY,   FORBIDDEN,     FORBIDDEN,     FORBIDDEN,
+			TRNG_APB_S_DOMAIN0_PERM, FORBIDDEN,     FORBIDDEN,     FORBIDDEN,
 			FORBIDDEN,     FORBIDDEN,     FORBIDDEN,     FORBIDDEN,
 			FORBIDDEN,     FORBIDDEN,     FORBIDDEN,     FORBIDDEN,
 			FORBIDDEN,     FORBIDDEN,     FORBIDDEN,     FORBIDDEN),
diff --git a/atf-20250711/plat/mediatek/mt7986/platform.mk b/atf-20250711/plat/mediatek/mt7986/platform.mk
index 4732b4f5..871f2449 100644
--- a/atf-20250711/plat/mediatek/mt7986/platform.mk
+++ b/atf-20250711/plat/mediatek/mt7986/platform.mk
@@ -73,5 +73,6 @@ $(call MAKE_DEP,bl2,bl2_boot_ram,RAM_BOOT_DEBUGGER_HOOK RAM_BOOT_UART_DL)
 $(call MAKE_DEP,bl2,bl2_boot_nand_nmbm,NMBM_MAX_RATIO NMBM_MAX_RESERVED_BLOCKS NMBM_DEFAULT_LOG_LEVEL)
 $(call MAKE_DEP,bl2,mt7986_gpio,ENABLE_JTAG)
 
-$(call GEN_DEP_RULES,bl31,bl31_plat_setup)
+$(call GEN_DEP_RULES,bl31,bl31_plat_setup devapc)
 $(call MAKE_DEP,bl31,bl31_plat_setup,ANTI_ROLLBACK TRUSTED_BOARD_BOOT)
+$(call MAKE_DEP,bl31,devapc,MT7986_TRNG_NS_ACCESS)
diff --git a/atf-20260123/plat/mediatek/apsoc_common/Config.in b/atf-20260123/plat/mediatek/apsoc_common/Config.in
index 2a82f224..9e82ecc8 100644
--- a/atf-20260123/plat/mediatek/apsoc_common/Config.in
+++ b/atf-20260123/plat/mediatek/apsoc_common/Config.in
@@ -754,6 +754,7 @@ config ENABLE_BL31_RUNTIME_LOG
 	default 1
 	depends on _ENABLE_BL31_RUNTIME_LOG
 
+source "plat/mediatek/mt7986/Config.in"
 source "plat/mediatek/mt7987/Config.in"
 source "plat/mediatek/mt7988/Config.in"
 
diff --git a/atf-20260123/plat/mediatek/mt7986/Config.in b/atf-20260123/plat/mediatek/mt7986/Config.in
new file mode 100644
index 00000000..2bb3f7c8
--- /dev/null
+++ b/atf-20260123/plat/mediatek/mt7986/Config.in
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: BSD-3-Clause
+#
+# MT7986 platform-specific configurations
+#
+
+if _PLAT_MT7986
+
+config _MT7986_TRNG_NS_ACCESS
+	bool "Allow non-secure world to access TRNG registers directly"
+	default n
+	help
+	  By default BL31 restricts the TRNG to secure world only and exposes
+	  random numbers through the MTK_SIP_TRNG_GET_RND SMC call.
+	  Vendor firmwares based on the MediaTek SDK kernel 5.4 read the TRNG
+	  registers directly and fail (hwrng errors) with this restriction.
+	  Say Y here to keep both the SMC interface and direct register access
+	  working, e.g. for boards which must boot both stock and OpenWrt
+	  firmware.
+
+# Makefile option
+config MT7986_TRNG_NS_ACCESS
+	int
+	default 1
+	depends on _MT7986_TRNG_NS_ACCESS
+
+endif # _PLAT_MT7986
diff --git a/atf-20260123/plat/mediatek/mt7986/bl31/bl31.mk b/atf-20260123/plat/mediatek/mt7986/bl31/bl31.mk
index 2fa6e75f..f73cf352 100644
--- a/atf-20260123/plat/mediatek/mt7986/bl31/bl31.mk
