@@ -55,5 +55,9 @@ ifeq ($(ENABLE_BL31_RUNTIME_LOG), 1)
 BL31_CPPFLAGS		+=	-DENABLE_BL31_RUNTIME_LOG
 endif
 
+ifeq ($(MT7986_TRNG_NS_ACCESS), 1)
+BL31_CPPFLAGS		+=	-DMT7986_TRNG_NS_ACCESS
+endif
+
